{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["playwright"],
  "extraKnownMarketplaces": {
    "llm-wiki": {
      "source": {
        "source": "github",
        "repo": "nvk/llm-wiki"
      }
    },
    "claude-mem": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/toolchain/delegate.mjs doctor)",
      "Bash(node scripts/toolchain/video-skills.mjs doctor)",
      "Bash(node scripts/toolchain/video-skills.mjs verify)"
    ],
    "deny": [
      "Bash(opencode)",
      "Bash(opencode *)",
      "Bash(npx opencode-ai *)",
      "Bash(npx @opencode/cli *)",
      "Bash(npm install -g opencode-ai*)",
      "Bash(npm i -g opencode-ai*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/toolchain/video-prompt-router.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
