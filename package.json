{
  "name": "sadeed",
  "description": "سَدِيد (SADEED) — منظومة القرار والإنجاز الذكي",
  "version": "1.5.1",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "sideEffects": [
    "**/*.css",
    "src/lib/sadeed/orchestrator/agents.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=5120 vite build",
    "prebuild:dev": "node scripts/write-build-info.mjs",
    "build:dev": "NODE_OPTIONS=--max-old-space-size=5120 vite build --mode development",
    "preview": "wrangler dev --config .output/server/wrangler.json --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:svg": "node scripts/check-svg.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "check:deadcode": "knip --no-progress --reporter compact",
    "test": "vitest run",
    "test:visual": "python3 tests/visual/hero_emblem_visual.py && python3 tests/visual/sadeed_card_visual.py",
    "test:visual:update": "UPDATE_BASELINES=1 python3 tests/visual/hero_emblem_visual.py && UPDATE_BASELINES=1 python3 tests/visual/sadeed_card_visual.py",
    "test:visual:sadeed": "python3 tests/visual/sadeed_card_visual.py",
    "test:visual:sadeed:update": "UPDATE_BASELINES=1 python3 tests/visual/sadeed_card_visual.py",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:performance && npm run check:contrast && npm run check:secrets && npm run check:audit",
    "check:ui": "node scripts/ui-audit.mjs",
    "check:prod": "node scripts/check-production.mjs",
    "check:rag": "bash scripts/rag-preflight.sh",
    "check:rag-measure": "bash scripts/rag-measure.sh",
    "check:contrast": "node scripts/check-background-contrast.mjs"
  },
