{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://jhutlofapjfjjeajawie.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "sadeed-mcp",
      "version": "0.1.0",
      "title": "SADEED — SADEED"
    },
    "tools": [
      {
        "name": "ping",
        "title": "Ping SADEED",
        "description": "Health check that returns the current server time and app name. Use to verify connectivity.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "ask_sadeed",
        "title": "Ask SADEED",
        "description": "Send a natural-language question to SADEED, the Executive AI Engine, and receive an executive briefing (bilingual AR/EN). Read-only reasoning; does not mutate app state.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Executive question in Arabic or English (max 2000 chars)."
            },
            "language": {
              "description": "Preferred reply language.",
              "type": "string",
              "enum": [
                "ar",
                "en"
              ]
            }
          },
          "required": [
            "question"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "hcis_status",
        "title": "HCIS Compliance Status",
        "description": "Read-only: HCIS industrial-security compliance percentage (overall and per Saudi region: central/western/eastern/southern) plus open critical or overdue findings with target dates. Bilingual data (AR titles).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "region": {
              "description": "Optional region filter.",
              "type": "string",
              "enum": [
                "central",
                "western",
                "eastern",
                "southern"
              ]
            },
            "include_findings": {
              "description": "Include the open critical/overdue findings list (default true).",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "ptw_active_permits",
        "title": "Active Work Permits (PTW)",
        "description": "Read-only: currently ACTIVE digital work permits, optionally filtered by Saudi region (central/western/eastern/southern) or type (hot_work, confined_space, restricted_area, excavation, lifting, electrical_isolation). Returns ref, type, region, location, contractor, worker count and expiry.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "region": {
              "description": "Optional region filter.",
              "type": "string",
              "enum": [
                "central",
                "western",
                "eastern",
                "southern"
              ]
            },
            "type_key": {
              "description": "Optional permit type key, e.g. hot_work or confined_space.",
              "type": "string",
              "maxLength": 40
            },
            "limit": {
              "description": "Max permits to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
