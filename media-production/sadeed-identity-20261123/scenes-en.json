  "language": "en",
  "scenes": [
    {
      "id": "why",
      "purpose": "Energy and accountability",
      "text": "In the energy sector, protection begins with a clear view. Information arrives from multiple sites and systems, while decisions need evidence and clear accountability.",
      "character_start": 0,
      "character_end_exclusive": 167,
      "speech_start": 0.256,
      "speech_end": 9.896,
      "start": 0,
      "end": 10.231
    },
    {
      "id": "platform",
      "purpose": "Connected platform design",
      "text": "That is the purpose of Sadeed: an industrial security platform designed to bring incidents, assets, risks, and actions into one connected context, helping decision-makers understand the situation and see what needs attention.",
      "character_start": 169,
      "character_end_exclusive": 394,
      "speech_start": 10.231,
      "speech_end": 24.103,
      "start": 10.231,
      "end": 24.625
    },
    {
      "id": "sources",
      "purpose": "Approved sources",
      "text": "The platform is designed to link events to their locations and potential impact, showing the source and freshness of information when approved data is available.",
      "character_start": 396,
      "character_end_exclusive": 557,
      "speech_start": 24.625,
      "speech_end": 33.226,
      "start": 24.625,
      "end": 33.702
    },
    {
      "id": "ai",
      "purpose": "AI and human approval",
      "text": "Its AI capabilities and specialized agents are designed to support search, evidence summaries, priority explanations, and suggested next steps. Authorized people remain responsible for approving decisions.",
      "character_start": 559,
      "character_end_exclusive": 764,
      "speech_start": 33.702,
      "speech_end": 46.579,
      "start": 33.702,
      "end": 46.989
    },
    {
      "id": "clarity",
      "purpose": "Clarity",
      "text": "Because time matters, Sadeed is designed to reduce searching and unnecessary steps, bringing relevant information forward clearly while showing what is still missing.",
      "character_start": 766,
      "character_end_exclusive": 932,
      "speech_start": 46.989,
      "speech_end": 56.695,
      "start": 46.989,
      "end": 57.164
    },
    {
      "id": "decision",
      "purpose": "Decision trail",
      "text": "From a question to a recommendation, and from approval to action tracking, the aim is a clear, reviewable process. Sadeed. A clearer view. Decisions grounded in evidence.",
      "character_start": 934,
      "character_end_exclusive": 1104,
      "speech_start": 57.164,
      "speech_end": 69.35471655328799,
      "start": 57.164,
      "end": 69.55471655328799
    }
  ],
