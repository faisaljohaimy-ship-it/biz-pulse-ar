# منصة إنجاز الأعمال — Local environment template
# Copy to .env and fill values locally. Never commit .env with values.
# Cloudflare and CI inject the VITE_SUPABASE_* / SUPABASE_* variables at
# runtime — leave them blank here and never commit production values.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_PUBLIC_URL=https://neexios.com
PUBLIC_SITE_URL=https://neexios.com
SITE_URL=https://neexios.com
APP_VERSION=1.5.1

# ── SERVER SECRETS — set in the PLATFORM, never commit values here ──────────
# These are the private keys that power SADEED and integrations. They live ONLY
# in the deployment platform's environment (Vercel → Settings → Environment
# Variables, or Cloudflare Worker Variables / `wrangler secret put`). Keep the
# values EMPTY in this template and out of `.env` (which is tracked and must
# hold public keys only — constitution art. 13).
#
# SADEED brain and Council of Ten — native Google Gemini (the default engine).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_TRANSCRIBE_MODEL=gemini-3.6-flash
GOOGLE_GENERATIVE_AI_API_KEY=
SADEED_MAX_OUTPUT_TOKENS=1500
# Chat engine selection (src/lib/sadeed/llm/provider-plan.server.ts). Zero-cost
# first: empty = gemini when its key is set, otherwise deterministic zero-cost
# answers only. gemini | openai | none — any other value fails safe to zero-cost.
SADEED_LLM_PROVIDER=
# Optional OpenAI chat adapter — disabled by default. Needs BOTH the key and
# SADEED_OPENAI_ENABLED=true. It becomes the engine either by default
# (SADEED_LLM_PROVIDER=openai) or per request (header X-SADEED-Provider: openai,
# owner decision 2026-10-23 "both"); a request without both gates gets an honest
# "not configured" reply — never a silent substitute for another engine.
# Model allowlist: gpt-5-mini | gpt-5 | gpt-5-nano.
OPENAI_API_KEY=
SADEED_OPENAI_ENABLED=
SADEED_OPENAI_MODEL=
# Metered backup gateway behind Gemini — off unless set to "lovable" (and
# LOVABLE_API_KEY below is present). No silent fallback to a metered provider.
SADEED_BACKUP_PROVIDER=
SADEED_ENABLE_MANAGED_EMAIL_QUEUE=
SADEED_OWNER_EMAIL=
SADEED_OWNER_SMS=
SADEED_DIRECT_SEND_ENABLED=false
# Keep false until all historical vectors have been re-embedded with the
# canonical Gemini embedding model and the RAG evaluation gates pass.
SADEED_GEMINI_RAG_READY=false
# Legacy hard-coded KB templates stay disabled and, even when explicitly
# enabled for review, are created as drafts rather than published evidence.
SADEED_ENABLE_LEGACY_REFERENCE_SEED=false
# FINN — owner-only coding & automation agent (separate from SADEED). Server-only.
# FINN_OWNER_USER_IDS: comma-separated Supabase user UUIDs of the owner(s). Unset,
# empty or any invalid entry ⇒ nobody can enter (fails closed). Set it in the PLATFORM,
# never commit a value. OPENAI_API_KEY is FINN's primary engine (GPT); without it FINN
# declares its fallback to the backup engine. FINN_OPENAI_MODEL is optional (default
# gpt-4.1) and is chosen by the server, never by the client.
FINN_OWNER_USER_IDS=
OPENAI_API_KEY=
FINN_OPENAI_MODEL=
# FINN read-only engineering tools (optional; each fails CLOSED with "not_configured" when unset).
# FINN_GITHUB_TOKEN: a fine-grained, READ-ONLY token scoped to the product repo only.
# FINN_VERCEL_TOKEN + FINN_VERCEL_PROJECT_ID (+ optional FINN_VERCEL_TEAM_ID): read-only deployment listing.
# Server-only. Never commit values; the tools can read, never write, deploy or execute.
FINN_GITHUB_TOKEN=
FINN_VERCEL_TOKEN=
FINN_VERCEL_PROJECT_ID=
FINN_VERCEL_TEAM_ID=
# FINN's daily quota is its OWN surface (separate buckets from SADEED chat, so public
# visitors can never lock the owner out). Optional; defaults 2000 (whole surface) / 500
# (per user). Tune without a deploy.
FINN_DAILY_GLOBAL=
FINN_DAILY_PER_IDENTITY=
# SADEED voice only (ElevenLabs — locked identity) + other server integrations.
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
LIVEAVATAR_API_KEY=
LEADS_NOTIFY_EMAIL=
CRON_HOOK_SECRET=
LOVABLE_SEND_URL=
# Optional: legacy outbound aliases and emergency dispatch. Live sends remain
# disabled with a clear configuration state until the matching values are set.
# ARIA_OUTBOUND_AUTO_APPROVE=true is a temporary compatibility alias. Prefer
# SADEED_DIRECT_SEND_ENABLED. Enabling it allows owner-only sends without the per-
# message human approval step. All other controls stay in force (admin/manager
# role, rate limits, provider-config gate, payload encryption, content-hash
# integrity, atomic one-time claim, full audit ledger). Leave empty/false to
# keep the human-approval flow. Live sends still require the provider keys below.
ARIA_OUTBOUND_AUTO_APPROVE=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=https://neexios.com/api/public/hooks/twilio-message-status
# At least 32 random characters. Signs approval tokens and encrypts payloads.
ARIA_MESSAGE_APPROVAL_SECRET=
STRIPE_SECRET_KEY=

# PDPL production controls — required for a release-candidate verdict.
# Use actual controller/operator facts only; never placeholders.
PDPL_CONTROLLER_NAME=
PDPL_CONTROLLER_REGISTRATION=
PDPL_DPO_NAME=
PDPL_PRIVACY_CONTACT_EMAIL=
PDPL_DATA_REGION=
# accepted values: approved | executed
PDPL_DPA_REGISTER_STATUS=
PDPL_ACCOUNT_ERASURE_DAYS=
PDPL_AUDIT_RETENTION_DAYS=
PDPL_OPERATIONAL_RETENTION_DAYS=
PDPL_BREACH_OWNER=
PDPL_LEGAL_APPROVAL_REF=

# Enterprise connectors
# Managed-connector transport key (Microsoft/email). Used for model inference
# ONLY when the owner opts in to the backup gateway (SADEED_BACKUP_PROVIDER=lovable).
LOVABLE_API_KEY=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OUTLOOK_API_KEY=
MICROSOFT_ONEDRIVE_API_KEY=
MICROSOFT_SHAREPOINT_API_KEY=
MICROSOFT_TEAMS_API_KEY=
MICROSOFT_SYNC_HOOK_SECRET=

POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=

SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
SAP_TENANT=
ORACLE_CONNECTION_STRING=
N8N_WEBHOOK_URL=
N8N_TOKEN=
GENERIC_REST_BASE_URL=
GENERIC_REST_TOKEN=

DATABASE_URL=

# Dedicated non-production account used only by blocking CI E2E checks.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# RLS isolation harness — two throwaway org accounts used ONLY by the
# cross-tenant RLS checks (never production identities). Leave empty locally.
RLS_TEST_ORG_A_ID=
RLS_TEST_ORG_A_EMAIL=
RLS_TEST_ORG_A_PASSWORD=
RLS_TEST_ORG_B_ID=
RLS_TEST_ORG_B_EMAIL=
RLS_TEST_ORG_B_PASSWORD=

# Voice / ARIA runtime flags
VITE_VOICE_DEBUG=false
VITE_GREETING_ENABLED=false

# RAG retrieval surface (phase ③) — NOT_GLOBAL: dark by default, enabled per
# environment only by the operator ("true" or "1"). RAG_EVAL_JWT is a real
# user session JWT used ONLY when running the live golden-set evaluation
# (src/test/rag-live-eval.test.ts) — never committed, never in client code.
VITE_RAG_RETRIEVAL_ENABLED=
RAG_EVAL_JWT=

# Hajj platform — the ONLY source of the external dashboard URL used by the
# homepage embed/preview (src/lib/hajj-embed.ts). Must be an https origin
# that ALLOWS framing (no X-Frame-Options: deny — hajj.neexios.com blocks
# embedding and will show the connect card instead). The UI never displays
# this URL as text; it always shows the product name.
VITE_HAJJ_EMBED_URL=https://hajj-nexus-prime.lovable.app/

# ───────────────────────────────────────────────────────────────────────────
# طبقة الأدوات (SADEED toolchain) — docs/tooling/SADEED_TOOLCHAIN.md
# أسماء فقط؛ القيم تُضبط في البيئة/أسرار CI لا في git. أدوات زمن تطوير لا تُستدعى
# من الإنتاج، والمفاتيح اختيارية حتى يُفعَّل مزوّدها.
# ───────────────────────────────────────────────────────────────────────────
# Context7 (MCP) — توثيق المكتبات الحيّ؛ يعمل بلا مفتاح بحدٍّ أدنى
CONTEXT7_API_KEY=
# 21st.dev Magic (MCP) — توليد مكوّنات الواجهة
TWENTYFIRST_API_KEY=
# Strix — فحص أمني ذاتيّ مأذون (CI بالطلب فقط)؛ تُضاف كأسرار مستودع في GitHub
STRIX_LLM=
STRIX_LLM_API_KEY=
