# Core data service
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Canonical ARIA intelligence + voice pipeline (server secret only)
GEMINI_API_KEY=replace_me
# Accepted legacy alias; leave empty when GEMINI_API_KEY is used.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# Keep true to guarantee that every ARIA reply uses native Gemini Flash.
ARIA_FORCE_GEMINI_FLASH=true

# Optional legacy chat fallbacks; used only when ARIA_FORCE_GEMINI_FLASH=false.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_SERVICE_TIER=auto
LOVABLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Registered direct-send destinations (not sender credentials)
ARIA_OWNER_EMAIL=Faisaljohaimy@gmail.com
# 00966500888778 is normalized internally to this canonical E.164 value.
ARIA_OWNER_SMS=+966500888778
# Owner-only direct send; set false for an immediate deployment kill switch.
ARIA_DIRECT_SEND_ENABLED=true
# Legacy alias retained for older NEXIOS environments.
ARIA_OUTBOUND_AUTO_APPROVE=true
ARIA_MESSAGE_APPROVAL_SECRET=replace_with_at_least_32_random_characters

# Email provider: configure Resend OR the Outlook connector.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ARIA <aria@your-verified-domain.example>
RESEND_WEBHOOK_SECRET=
MICROSOFT_OUTLOOK_API_KEY=
# Enable only if email_send_log, enqueue_email and its queue worker are installed.
ARIA_ENABLE_MANAGED_EMAIL_QUEUE=false

# SMS provider: Twilio requires credentials and one sender option.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=https://your-domain.example/api/webhooks/twilio

# Enable only behind a trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY_HEADERS=false
