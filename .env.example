# NEXIOS — Local environment template
# Copy to .env and fill values locally. Never commit .env with values.
# Lovable Cloud auto-manages the VITE_SUPABASE_* / SUPABASE_* variables at
# runtime — leave them blank here; they are injected by the platform.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Voice / ARIA runtime flags
VITE_VOICE_DEBUG=false
VITE_GREETING_ENABLED=false
VITE_VOICE_FALLBACK=el-only

# Hajj Nexus Prime — external embed URL for /hajj-prime
VITE_HAJJ_EMBED_URL=https://hajj.neexios.com/?theme=dark&forceDark=1#dark
