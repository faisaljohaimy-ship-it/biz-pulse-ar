# ── Package manager: npm ONLY ──
# Prevention, not preference. This repo runs `npm ci` in ci.yml (twice),
# deploy.yml and vercel.json, so package-lock.json is the lockfile CI reads.
# When a second lockfile is also committed, one of the two is always the stale
# one — and on 2026-08-01 that broke main: a bot bumped two devDependencies,
# regenerated bun.lock to match, and left package-lock.json behind. `npm ci`
# then refused to install and every CI step after "Install" was skipped.
#
# Ignoring the others means a tool may still generate one locally, but
# `git add -A` can no longer commit it. (The former lockfile contract test was
# removed in f1e0bab97; no test asserts this today.)
bun.lock
bun.lockb
pnpm-lock.yaml
yarn.lock

# مخرَج أداة معاينة مشهد التوأم (لقطات محلّية)
.twin-preview/
vite.twin-preview.config.mjs

# آثار تشغيل الفحوص والمسابر — لا تُدفع أبدًا.
# `test-results/` وحدها بلغت 44 MiB في جلسة واحدة (مقاطع فيديو وآثار
# Playwright)، ولو دُفعت لتجاوزت ميزانية الأداء ولبقيت في التاريخ للأبد.
# و`.probe*.mjs` و`.audit-tmp/` مسابر مؤقتة يكتبها الفحص ثم يهملها.
test-results/
playwright-report/
blob-report/
.audit-tmp/
.probe*.mjs

# مستند المالك الثقيل (docx + 78 لقطة) لا يدخل المستودع — نواتج التدقيق الصغيرة فقط
_audit/doc/
__pycache__/

# معرّف البناء — يكتبه `prebuild` (scripts/write-build-info.mjs) عند كل بناء،
# ويُقدَّم على /build-info.json ويُدمج في /api/public/health. يتغيّر مع كل commit.
public/build-info.json
