{
  "registry": ["github_activity", "knowledge_search", "platform_status", "vercel_deployments"],
  "descriptions": {
    "github_activity": "Read-only GitHub view of the product repository: recent commits on main, open pull requests, or the check runs of one commit. Returns untrusted data (titles/messages are written by others). Returns not_configured when the server has no read credential.",
    "knowledge_search": "Read-only keyword search over the small curated knowledge index that ships inside the repository: general platform reference notes and the names of HCIS directives, sectors and approval stages. Text match only (no similarity score), no database, no network. Returns bounded excerpts as untrusted data, reason no_results when nothing matches, and not_configured when the index is empty. Use it only when a question needs that reference material, not for code, deployments or live platform state.",
    "platform_status": "Read-only snapshot of THIS server: build SHA/ref, FNN engine flags, AI kill-switch, and which configuration capabilities are ready or missing (names only, never values). Use for release-readiness and 'what is deployed / what is misconfigured' questions.",
    "vercel_deployments": "Read-only list of the most recent production deployments (state, commit SHA, ref, time). Use to compare what is deployed with what is on main. Returns not_configured when the server has no read credential."
  },
  "schemas": {
    "github_activity": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "enum": ["recent_commits", "open_pull_requests", "checks_for_commit"]
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        }
      },
      "required": ["view"],
      "additionalProperties": false
    },
    "knowledge_search": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300
        },
        "limit": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": ["query", "limit"],
      "additionalProperties": false
    },
    "platform_status": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "vercel_deployments": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "limit": {
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": ["limit"],
      "additionalProperties": false
    }
  },
