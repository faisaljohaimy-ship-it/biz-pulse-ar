{
  "id": "nx.data.inspect-schema",
  "nameEn": "Inspect Schema",
  "nameAr": "منصة البيانات — Inspect Schema",
  "description": "Inspect Schema through NEXIOS Data Platform to query, validate, govern, and publish trusted enterprise data.",
  "logicalCategory": "data-platform",
  "registryCategory": "sql",
  "provider": "NEXIOS Data Platform",
  "operation": "read",
  "sideEffect": false,
  "risk": "low",
  "approvalRequired": false,
  "approvalPolicy": {
    "mode": "none",
    "minimumRole": "user",
    "requireJustification": false,
    "expireAfterMinutes": 0
  },
  "permissions": [
    "admin",
    "moderator",
    "user"
  ],
  "authType": "nexios-service-role-rls",
  "idempotent": true,
  "rollbackKind": "none",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "requestId",
      "orgId"
    ],
    "properties": {
      "requestId": {
        "type": "string",
        "minLength": 8,
        "description": "Caller-generated idempotency and audit correlation identifier."
      },
      "orgId": {
        "type": "string",
        "format": "uuid",
        "description": "Explicit NEXIOS tenant identifier; never infer across organizations."
      },
      "resourceId": {
        "type": "string",
        "minLength": 1,
        "description": "Target resource identifier when the operation addresses one object."
      },
      "query": {
        "type": "string",
        "maxLength": 4000,
        "description": "Bounded search or analytical query."
      },
      "filters": {
        "type": "object",
        "additionalProperties": true,
        "description": "Provider-approved filter fields."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000,
        "default": 100
      },
      "payload": {
        "type": "object",
        "additionalProperties": true,
        "description": "Validated operation payload. Connector adapters must reject unknown privileged fields."
      },
      "justification": {
        "type": "string",
        "minLength": 12,
        "maxLength": 2000,
        "description": "Human-readable reason recorded in the approval and audit ledger."
      },
      "expectedVersion": {
        "type": "string",
        "description": "Optimistic concurrency value when supported by the provider."
      },
      "dryRun": {
        "type": "boolean",
        "default": true,
        "description": "Preview mode. Production adapters must preserve dry-run semantics when available."
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status",
      "operationId",
      "audit"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "succeeded",
          "pending_approval",
          "rejected",
          "failed",
          "not_configured"
        ]
      },
      "operationId": {
        "type": "string"
      },
      "data": {},
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "source",
            "observedAt"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "sourceId": {
              "type": "string"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": true
        }
      },
      "audit": {
        "type": "object",
        "required": [
          "requestId",
          "orgId",
          "toolId"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "orgId": {
            "type": "string",
            "format": "uuid"
          },
          "toolId": {
            "const": "nx.data.inspect-schema"
          },
          "actorId": {
            "type": "string"
          },
          "approvedBy": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "timeoutMs": 15000,
  "maxRetries": 2,
  "dataClassification": "internal",
  "implementationStatus": "descriptor_only",
  "enabled": false,
  "connectorRequirements": [
    "Configured NEXIOS Data Platform adapter",
    "Approved nexios-service-role-rls credential",
    "Tenant isolation test",
    "Input and output schema validation",
    "Read audit logging",
    "Trace, timeout, retry, and error mapping"
  ],
  "version": 1,
  "pack": "nexios-modern-agents-tools-pack"
}
